@model CreateRoleVM

@{
    ViewData["Title"] = "Create Role";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <h2 class="card-title mb-4">Create Role</h2>

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="RoleName" class="form-label"></label>
                        <input asp-for="RoleName" class="form-control" placeholder="Enter role name">
                        <span asp-validation-for="RoleName" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Create Role</button>
                </form>

                <div class="mt-3 text-center">
                    <a asp-action="Index" asp-controller="Home" class="text-decoration-none">← Back to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
