@model ProductReadVM
<div class="d-flex flex-column align-items-center ">

    <div class="d-flex justify-content-center container mt-5 mb-5">
        <div class="card p-3 bg-white" style="width:444px;">
            <i class="fa fa-apple"></i>
            <div class="about-product text-center mt-2">
                <img src="~/Images/Products/@Model.ImgeUrl" width="300">
                <div>
                    <h4>@Model.Title</h4>
                    <h6 class="mt-0 text-black-50">@Model.Description</h6>
                </div>
            </div>
            <div class="stats mt-2">
                <div class="d-flex justify-content-between p-price"><span>Category</span><span>@Model.Category</span></div>
                <div class="d-flex justify-content-between p-price"><span>Count</span><span>@Model.Count :left</span></div>
            </div>
            <div class="d-flex justify-content-between total font-weight-bold mt-4"><span>Price</span><span>$@Model.Price</span></div>
        </div>
    </div>  
</div>