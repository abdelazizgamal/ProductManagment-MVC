@model CategoryCreateVM
<h1 class="bg-success text-white text-center">Create Category</h1>
<br />
<hr />
<br />

@using (Html.BeginForm("Create", "Category", FormMethod.Post))
{
    <div class="mb-3 form-group">
        @Html.LabelFor(d => d.Name, new { @class = "form-label" })
        @Html.TextBoxFor(d => d.Name, new
        {
            @class = "form-control",
        required = "required" ,
        placeholder = "Enter Category Name"
        })
    <span asp-validation-for="Name" class="text-danger"></span>


</div>

<div class="d-flex justify-content-center gap-3">
    <input type="submit" class="btn btn-success" value="Create Category" />
    @Html.ActionLink("Cancel", "Index", "Category", null, new { @class = "btn btn-secondary" })
</div>
}



@section Scripts
{
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

}