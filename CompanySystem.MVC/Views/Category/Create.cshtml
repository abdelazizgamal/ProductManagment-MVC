@model CategoryCreateVM

@{
    ViewData["Title"] = "Create Category";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h2 class="card-title mb-4">Create Category</h2>

                @using (Html.BeginForm("Create", "Category", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        @Html.LabelFor(d => d.Name, new { @class = "form-label" })
                        @Html.TextBoxFor(d => d.Name, new
                        {
                            @class = "form-control",
                            required = "required",
                            placeholder = "Enter category name"
                        })
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Create</button>
                }

                <div class="mt-3 text-center">
                    <a asp-controller="Category" asp-action="Index" class="text-decoration-none">← Back to list</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}