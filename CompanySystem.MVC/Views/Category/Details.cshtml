@model CategoryReadVM

@{
    ViewData["Title"] = "Category Details";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h2 class="card-title mb-4">Category Details</h2>

                <div class="mb-3">
                    <strong>ID:</strong> @Model.Id
                </div>
                <div class="mb-3">
                    <strong>Name:</strong> @Model.Name
                </div>

                <div class="d-flex gap-2">
                    <a asp-controller="Category" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                    <a asp-controller="Category" asp-action="Index" class="btn btn-secondary">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>