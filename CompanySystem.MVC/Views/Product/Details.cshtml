@model ProductReadVM

@{
    ViewData["Title"] = "Product Details";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h2 class="card-title mb-4">Product Details</h2>

                @if (!string.IsNullOrEmpty(Model.ImgeUrl))
                {
                    <div class="text-center mb-4">
                        <img src="~/Images/Products/@Model.ImgeUrl" class="img-fluid" style="max-width: 300px;" alt="@Model.Title" />
                    </div>
                }

                <div class="mb-3">
                    <strong>Title:</strong> @Model.Title
                </div>
                <div class="mb-3">
                    <strong>Description:</strong> @Model.Description
                </div>
                <div class="mb-3">
                    <strong>Price:</strong> $@Model.Price
                </div>
                <div class="mb-3">
                    <strong>Category:</strong> @Model.Category
                </div>
                <div class="mb-3">
                    <strong>Count Available:</strong> @Model.Count
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-controller="Product" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                    <a asp-action="Index" asp-controller="Product" class="btn btn-secondary">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>